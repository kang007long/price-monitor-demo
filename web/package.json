{
  "name": "price-monitor-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Static Next.js dashboard for the Price Monitor Demo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs out 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "next build && playwright test",
    "test:server": "node --test scripts/serve.test.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.28.5"
}
